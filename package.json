{
  "name": "velvet-frame-cinema",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc --target ES2022 --module commonjs --lib es2022,dom --outDir .test-dist --skipLibCheck --esModuleInterop data/films.ts lib/booking.ts && node --test tests/*.test.cjs",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "qa:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@types/node": "24.0.0",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.22.0",
    "globals": "16.0.0",
    "playwright": "1.51.1",
    "typescript": "5.8.2",
    "typescript-eslint": "8.26.0"
  }
}
